{
  "manifest_version": 3,
  "name": "Spotter",
  "version": "0.1.0",
  "description": "Your competitive-programming spotter, docked beside the problem. Hints, never solutions.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*",
    "https://leetcode.com/*",
    "https://open.kattis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Spotter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
